# Where you've installed Compass
BASE_URL=https://compass.example.com/

# Atlas is used for geocoding trips.
# You can use mine or install your own.
# Source code: https://github.com/aaronpk/Atlas
ATLAS_BASE=https://atlas.p3k.io/

# Map tiles come from Mapbox. Set your own public access token and, optionally,
# a different style as "user/style-id". If these are left out, the token that
# ships with Compass and the mapbox/light-v10 style are used.
# MAPBOX_TOKEN=pk.your-token
# MAPBOX_STYLE=mapbox/light-v10

# This is where the location data will be saved, MAKE SURE PATH ENDS WITH /
# Compass will create a folder for each "database" you create after you log in.
# Make sure the web server or PHP process can write here.
STORAGE_DIR=/var/compass/data/

# Used to encrypt session data. Generate one with `php artisan key:generate`.
# Keys from older installs (a plain 32 character string) still work.
APP_KEY=

# Define your database connection
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=compass
DB_USERNAME=compass
DB_PASSWORD=secret

# Cookie driver is probably fine. Alternate options:
# https://laravel.com/docs/12.x/session
SESSION_DRIVER=cookie
SESSION_LIFETIME=500000

# Processing trips is done on a job queue (jobs go on the "compass" queue).
# If using the database queue, you'll need to create the jobs table.
# (QUEUE_DRIVER and CACHE_DRIVER from older installs still work.)
QUEUE_CONNECTION=database
# QUEUE_CONNECTION=redis

CACHE_STORE=redis

# If this is true, then anyone can create accounts. If false, then only existing
# users in the users table will be able to log in. You can add your own domain name
# to the users table to allow yourself to log in the first time.
ALLOW_NEW_USERS=false

APP_ENV=local
APP_DEBUG=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Live sharing: where Compass publishes new locations for nginx's nchan module
# to push to viewers (see deploy/nginx-nchan.conf). Leave unset to have shared
# maps refresh every few seconds instead.
# NCHAN_PUBLISH_URL=http://127.0.0.1:8090/pub

# Set to false to stop keeping the stats tables up to date as data arrives
# STATS_ENABLED=true
